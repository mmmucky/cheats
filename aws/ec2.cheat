% aws, ec2, vpc

### Viewing
# List spot price requests
aws ec2 describe-spot-instance-requests --query 'SpotInstanceRequests[].[InstanceId,SpotInstanceRequestId,SpotPrice,Type,State]'

# List subnets
nu -c 'aws ec2 describe-subnets | from json | get Subnets | select VpcId SubnetId CidrBlock AvailabilityZone AvailabilityZoneId DefaultForAz MapPublicIpOnLaunch | sort-by VpcId AvailabilityZone CidrBlock'

# List instances by tag
aws ec2 describe-instances --filters "Name=tag:<Name>,Values=<Value>" --query "Reservations[].Instances[].[InstanceId,State.Name]"   --output table
